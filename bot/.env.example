# Copy to .env. Never commit .env.
ENV=development
PORT=8090
DATABASE_URL=postgres://user:password@localhost:5432/connect_coffee
# openssl rand -base64 48
SESSION_SECRET=

# First panel sign-in, created on first start.
ADMIN_EMAIL=admin@connect.local
ADMIN_PASSWORD=

COMPANY_NAME=Connect Speciality Coffee Roasters
CORS_ORIGINS=http://localhost:5175

# WhatsApp — leave ACCESS_TOKEN empty for dry run (logged, not sent).
ACCESS_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
META_APP_SECRET=
# Public https address of the bot (your tunnel), for the webhook and photos.
PUBLIC_URL=

# The cafe's WhatsApp, for booking alerts.
TEAM_WHATSAPP_NUMBER=
